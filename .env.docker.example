# HealixDz : réglages du déploiement Docker (voir DEPLOIEMENT.md).
#
# Copiez ce fichier en .env, à côté de docker-compose.yml, puis remplissez-le :
#   PowerShell : Copy-Item .env.docker.example .env
#   Git Bash   : cp .env.docker.example .env
# .env contient des secrets : Git l'ignore ; ne le versionnez ni ne le
# partagez jamais.
#
# Secrets : valeurs longues et aléatoires, lettres et chiffres uniquement
# (certaines entrent dans des URL). Pour en générer une (64 caractères
# hexadécimaux) :
#   Git Bash   : openssl rand -hex 32
#   PowerShell : $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') })

# --- Adresses publiques -----------------------------------------------------
# Exactement ce que l'utilisateur tape dans le navigateur (schéma, hôte,
# port, sans / final). APP_PUBLIC_URL sert aussi d'origine CORS et de base aux
# liens des e-mails : ouvrez le site avec cette adresse et aucune autre
# (pour le navigateur, 127.0.0.1 n'est pas localhost).
APP_PUBLIC_URL=http://localhost:3000
# L'API telle que le navigateur l'atteint. Écrite dans le frontend au moment
# du build : après un changement, reconstruisez-le (docker compose build frontend).
PUBLIC_API_URL=http://localhost:3001/api

# Ports publiés. Ils doivent correspondre aux ports des deux adresses ci-dessus.
FRONTEND_PORT=3000
BACKEND_PORT=3001
# 127.0.0.1 : accessible depuis cet ordinateur seulement (démonstration, ou
# proxy inverse sur la même machine). 0.0.0.0 : toutes les interfaces réseau.
BIND_ADDRESS=127.0.0.1

# true dès que le site est servi en HTTPS (cookies envoyés seulement sur TLS).
COOKIE_SECURE=false
# « trust proxy » d'Express : loopback sans proxy inverse ; derrière un proxy,
# son adresse (ou un nombre de sauts), pour que les limites de débit voient
# l'IP du client.
TRUST_PROXY=loopback

# --- MySQL ------------------------------------------------------------------
MYSQL_DATABASE=healixdz
MYSQL_USER=healixdz
# Lettres et chiffres uniquement : il entre dans l'URL DATABASE_URL du backend.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Authentification -------------------------------------------------------
# Quatre secrets différents. En changer un déconnecte tous les utilisateurs.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_REFRESH_SECRET=
# Chemin de la page de connexion de l'administration (écrit aussi dans le
# frontend au build). Choisissez-en un difficile à deviner.
ADMIN_GATE_PATH=/hzdz-control-gate-2026
BCRYPT_SALT_ROUNDS=12

# --- Service IA -------------------------------------------------------------
# Secret partagé entre le backend et le service IA.
AI_SERVICE_TOKEN=
# Dossier de l'hôte contenant les poids .pth, monté en lecture seule (jamais
# copié dans l'image). Relatif à ce dossier, ou absolu : C:\HealixDz\models
AI_MODELS_DIR=./models

# --- E-mails (réinitialisation du mot de passe) -----------------------------
# Obligatoires en production : sans SMTP_HOST, MAIL_FROM et APP_PUBLIC_URL, le
# backend refuse de démarrer. Avec docker-compose.dev.yml (démonstration), ils
# peuvent rester vides : les e-mails sont alors écrits dans les logs du backend.
SMTP_HOST=
# 587 avec SMTP_SECURE=false (STARTTLS), ou 465 avec SMTP_SECURE=true (TLS).
SMTP_PORT=587
SMTP_SECURE=false
# Laissez les deux vides pour un serveur sans authentification.
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur, par exemple : HealixDz <no-reply@exemple.dz>
MAIL_FROM=

# --- Premier administrateur (une seule fois) --------------------------------
# Lus uniquement par : docker compose --profile seed run --rm admin-seed
# Crée le compte SUPER_ADMIN (et les formules d'abonnement). Videz
# ADMIN_SEED_PASSWORD une fois le compte créé.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FULL_NAME=
ADMIN_SEED_PHONE=admin-healixdz
# true : remet le mot de passe d'un administrateur existant à ADMIN_SEED_PASSWORD.
ADMIN_SEED_UPDATE_PASSWORD=false

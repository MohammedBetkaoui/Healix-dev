# HealixDz : réglages du déploiement Docker (voir DEPLOIEMENT.md).
#
# Copiez ce fichier en .env, à côté de docker-compose.yml, puis remplissez-le :
#   PowerShell : Copy-Item .env.docker.example .env
#   Git Bash   : cp .env.docker.example .env
# .env contient des secrets : Git l'ignore ; ne le versionnez ni ne le
# partagez jamais.
#
# Secrets : valeurs longues et aléatoires, lettres et chiffres uniquement
# (certaines entrent dans des URL). Pour en générer une (64 caractères
# hexadécimaux) :
#   Git Bash   : openssl rand -hex 32
#   PowerShell : $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); -join ($b | ForEach-Object { $_.ToString('x2') })

# --- Domaine public (Caddy, HTTPS) ------------------------------------------
# Le nom de domaine du site, sans https:// ni / : son enregistrement DNS doit
# pointer vers ce serveur, ports 80 et 443 ouverts. Caddy obtient et renouvelle
# seul le certificat Let's Encrypt. L'interface est servie sur
# https://APP_DOMAIN et l'API sur https://APP_DOMAIN/api (même origine).
# Démonstration locale (docker-compose.dev.yml) : mettez localhost.
APP_DOMAIN=
# Adresse de contact du compte Let's Encrypt (avis d'expiration). En
# démonstration locale, n'importe quelle adresse convient (inutilisée).
ACME_EMAIL=

# Facultatif : à ne définir que pour s'écarter des valeurs déduites de
# APP_DOMAIN (https://APP_DOMAIN et https://APP_DOMAIN/api). PUBLIC_API_URL
# est écrite dans le frontend au build : reconstruisez-le après un changement.
# APP_PUBLIC_URL=
# PUBLIC_API_URL=

# --- Démonstration locale (docker-compose.dev.yml uniquement) ---------------
# Port de cet ordinateur sur lequel Caddy répond en HTTP. Si 80 est déjà pris
# (IIS, Apache de XAMPP…), mettez 8080 par exemple, et DEV_PUBLIC_URL à
# http://localhost:8080.
DEV_HTTP_PORT=80
DEV_PUBLIC_URL=http://localhost

# --- Réseau Docker (facultatif) ---------------------------------------------
# Sous-réseau du réseau « edge » (Caddy, frontend, backend) et adresse fixe de
# Caddy, hors de la plage attribuée aux autres conteneurs. À changer seulement
# en cas de conflit avec un réseau existant. Le backend ne croit que le
# X-Forwarded-For venant de CADDY_IP (TRUST_PROXY en découle).
# EDGE_SUBNET=172.30.0.0/24
# EDGE_IP_RANGE=172.30.0.128/25
# CADDY_IP=172.30.0.10

# --- MySQL ------------------------------------------------------------------
MYSQL_DATABASE=healixdz
MYSQL_USER=healixdz
# Lettres et chiffres uniquement : il entre dans l'URL DATABASE_URL du backend.
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# --- Authentification -------------------------------------------------------
# Quatre secrets différents. En changer un déconnecte tous les utilisateurs.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ADMIN_JWT_ACCESS_SECRET=
ADMIN_JWT_REFRESH_SECRET=
# Chemin de la page de connexion de l'administration (écrit aussi dans le
# frontend au build). Choisissez-en un difficile à deviner.
ADMIN_GATE_PATH=/hzdz-control-gate-2026
# Facultatif, recommandé : n'ouvrir l'administration (ses pages et /api/admin)
# qu'à ces adresses, séparées par des espaces (IP ou plages CIDR : bureaux,
# VPN). Les autres reçoivent une erreur 403 de Caddy. Vide : ouverte à tous.
# ADMIN_ALLOWED_IPS=203.0.113.10 198.51.100.0/24
BCRYPT_SALT_ROUNDS=12

# --- Service IA -------------------------------------------------------------
# Secret partagé entre le backend et le service IA.
AI_SERVICE_TOKEN=
# Dossier de l'hôte contenant les poids .pth, monté en lecture seule (jamais
# copié dans l'image). Relatif à ce dossier, ou absolu : C:\HealixDz\models
AI_MODELS_DIR=./models

# --- E-mails (réinitialisation du mot de passe) -----------------------------
# Obligatoires en production : sans SMTP_HOST, MAIL_FROM et APP_PUBLIC_URL, le
# backend refuse de démarrer. Avec docker-compose.dev.yml (démonstration), ils
# peuvent rester vides : les e-mails sont alors écrits dans les logs du backend.
SMTP_HOST=
# 587 avec SMTP_SECURE=false (STARTTLS), ou 465 avec SMTP_SECURE=true (TLS).
SMTP_PORT=587
SMTP_SECURE=false
# Laissez les deux vides pour un serveur sans authentification.
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur, par exemple : HealixDz <no-reply@exemple.dz>
MAIL_FROM=

# --- Sauvegardes ------------------------------------------------------------
# Dossier de l'hôte où le service backup dépose chaque nuit la base et les
# fichiers patients. Données de santé : un disque chiffré, et une copie hors
# du serveur. Sous Linux, il doit appartenir à l'utilisateur 1000
# (sudo chown 1000:1000 <dossier>).
BACKUP_DIR=./backups
# Heure de la sauvegarde (HH:MM, 24 h) dans ce fuseau horaire.
BACKUP_TIME=02:30
BACKUP_TZ=Africa/Algiers
# Durée de conservation, en jours.
BACKUP_RETENTION_DAYS=14
# Fortement recommandé : clé PUBLIQUE age (age1…) qui chiffre chaque archive.
# La clé privée correspondante ne doit PAS rester sur ce serveur : sans elle,
# une sauvegarde volée est illisible ; perdue, les sauvegardes le sont aussi.
# Générer la paire ailleurs : age-keygen -o healixdz-backup.key
BACKUP_AGE_RECIPIENT=

# --- Premier administrateur (une seule fois) --------------------------------
# Lus uniquement par : docker compose --profile seed run --rm admin-seed
# Crée le compte SUPER_ADMIN (et les formules d'abonnement). Videz
# ADMIN_SEED_PASSWORD une fois le compte créé.
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
ADMIN_SEED_FULL_NAME=
ADMIN_SEED_PHONE=admin-healixdz
# true : remet le mot de passe d'un administrateur existant à ADMIN_SEED_PASSWORD.
ADMIN_SEED_UPDATE_PASSWORD=false

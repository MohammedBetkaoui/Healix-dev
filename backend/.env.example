DATABASE_URL="mysql://root@127.0.0.1:3306/healixdz_db"
# Optional: an EMPTY database that Prisma may wipe, to replay the migrations
# and compare them with schema.prisma (prisma migrate diff --from-migrations,
# as the CI does). Never the application database.
# SHADOW_DATABASE_URL="mysql://root@127.0.0.1:3306/healixdz_shadow"
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_ACQUIRE_TIMEOUT_MS=30000
DATABASE_SOCKET_TIMEOUT_MS=10000
DATABASE_POOL_LIMIT=10
DATABASE_POOL_MIN_IDLE=1
DATABASE_POOL_IDLE_TIMEOUT_SECONDS=60
DATABASE_TRANSACTION_MAX_WAIT_MS=10000
DATABASE_TRANSACTION_TIMEOUT_MS=15000
DATABASE_VERIFY_ON_STARTUP=false
DATABASE_CONNECT_RETRIES=5
DATABASE_CONNECT_RETRY_DELAY_MS=1500
PORT=3001
FRONTEND_URL="http://localhost:3000"
BCRYPT_SALT_ROUNDS=12
JWT_ACCESS_SECRET="healixdz_access_secret_change_me"
JWT_REFRESH_SECRET="healixdz_refresh_secret_change_me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
COOKIE_SECURE=false
UPLOAD_ROOT="./uploads"
MAX_VERIFICATION_FILE_SIZE_MB=5
ALLOWED_VERIFICATION_FILE_TYPES="application/pdf,image/jpeg,image/png"
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD="change_me"
ADMIN_SEED_FULL_NAME="HealixDZ Super Admin"
ADMIN_SEED_PHONE="admin-healixdz"
ADMIN_SEED_UPDATE_PASSWORD=false
ADMIN_JWT_ACCESS_SECRET="change_me_admin_access_secret"
ADMIN_JWT_REFRESH_SECRET="change_me_admin_refresh_secret"
ADMIN_JWT_ACCESS_EXPIRES_IN="10m"
ADMIN_JWT_REFRESH_EXPIRES_IN="12h"
ADMIN_COOKIE_SECURE=false
ADMIN_FRONTEND_URL="http://localhost:3000"
ADMIN_GATE_PATH="/hzdz-control-gate-2026"

# AI inference service (ai-service/). The token must equal its AI_SERVICE_TOKEN.
AI_SERVICE_URL=http://127.0.0.1:8001
AI_SERVICE_TOKEN=

# E-mails (password reset). Without SMTP_HOST, in development, e-mails are
# NOT sent: they are written to the backend logs, links included. In
# production (NODE_ENV=production), SMTP_HOST, MAIL_FROM and APP_PUBLIC_URL
# are required: the backend refuses to start without them.
SMTP_HOST=
# 587 with SMTP_SECURE=false (STARTTLS), or 465 with SMTP_SECURE=true (TLS).
SMTP_PORT=587
SMTP_SECURE=false
# Leave both empty for a server without authentication.
SMTP_USER=
SMTP_PASSWORD=
# Sender shown to the recipient, e.g. "HealixDz <no-reply@example.dz>".
MAIL_FROM=
# Public URL of the frontend, used to build the links in e-mails
# (APP_PUBLIC_URL/reset-password?token=...). Falls back to FRONTEND_URL in
# development.
APP_PUBLIC_URL="http://localhost:3000"

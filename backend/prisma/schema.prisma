// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  SUPER_ADMIN
  ESTABLISHMENT_ADMIN
  AFFILIATED_DOCTOR
  INDEPENDENT_DOCTOR
}

enum AccountStatus {
  BASIC_ACCOUNT
  PENDING_VERIFICATION
  VERIFIED_NO_PLAN
  PAYMENT_PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum EstablishmentType {
  CLINIC
  HOSPITAL
  IMAGING_CENTER
  LABORATORY
  GROUP_PRACTICE
}

enum VerificationStatus {
  NOT_STARTED
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

enum SubscriptionStatus {
  NO_PLAN
  PAYMENT_PENDING
  ACTIVE
  EXPIRED
  CANCELED
}

model User {
  id              String        @id @default(cuid())
  fullName        String        @map("full_name") @db.VarChar(120)
  email           String        @unique @db.VarChar(191)
  phone           String        @unique @db.VarChar(32)
  passwordHash    String        @map("password_hash") @db.VarChar(255)
  role            UserRole
  accountStatus   AccountStatus @map("account_status")
  isEmailVerified Boolean       @default(false) @map("is_email_verified")
  isPhoneVerified Boolean       @default(false) @map("is_phone_verified")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  establishment Establishment?
  doctorProfile DoctorProfile?
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

model Establishment {
  id                 String             @id @default(cuid())
  name               String             @db.VarChar(150)
  type               EstablishmentType
  wilaya             String             @db.VarChar(80)
  address            String             @db.VarChar(255)
  professionalEmail  String             @map("professional_email") @db.VarChar(191)
  phone              String             @db.VarChar(32)
  managerFullName    String             @map("manager_full_name") @db.VarChar(120)
  verificationStatus VerificationStatus @map("verification_status")
  subscriptionStatus SubscriptionStatus @map("subscription_status")
  ownerId            String             @unique @map("owner_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  owner          User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  doctorProfiles DoctorProfile[]

  @@map("establishments")
}

model DoctorProfile {
  id                  String             @id @default(cuid())
  userId              String             @unique @map("user_id")
  speciality          String             @db.VarChar(100)
  wilaya              String             @db.VarChar(80)
  professionalAddress String             @map("professional_address") @db.VarChar(255)
  isIndependent       Boolean            @default(true) @map("is_independent")
  establishmentId     String?            @map("establishment_id")
  verificationStatus  VerificationStatus @map("verification_status")
  subscriptionStatus  SubscriptionStatus @map("subscription_status")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)

  @@index([establishmentId])
  @@map("doctor_profiles")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id")
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("audit_logs")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  tokenHash String   @map("token_hash") @db.Text
  userAgent String?  @map("user_agent") @db.VarChar(255)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  expiresAt DateTime @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

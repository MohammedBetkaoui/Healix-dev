// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN_VERIFICATION
  ESTABLISHMENT_ADMIN
  AFFILIATED_DOCTOR
  INDEPENDENT_DOCTOR
}

enum AccountStatus {
  BASIC_ACCOUNT
  PENDING_VERIFICATION
  VERIFIED_NO_PLAN
  PAYMENT_PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum EstablishmentType {
  CLINIC
  HOSPITAL
  IMAGING_CENTER
  LABORATORY
  GROUP_PRACTICE
}

enum VerificationStatus {
  NOT_STARTED
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

// TRIALING: the free trial (a Subscription with trial = true). It is a live
// status, like ACTIVE: the account may write, within the trial quotas.
enum SubscriptionStatus {
  NO_PLAN
  PAYMENT_PENDING
  ACTIVE
  EXPIRED
  CANCELED
  TRIALING
}

// What happened to a subscription, one SubscriptionEvent per change.
enum SubscriptionEventType {
  TRIAL_STARTED
  PURCHASED
  RENEWED
  PLAN_CHANGED
  EXPIRED
  CANCELED
  TRIAL_EXTENDED
  QUOTAS_CHANGED
}

enum VerificationRequestType {
  ESTABLISHMENT
  INDEPENDENT_DOCTOR
}

enum AccountType {
  ESTABLISHMENT
  INDEPENDENT_DOCTOR
}

enum BillingPeriod {
  MONTHLY
  ANNUAL
}

enum PaymentMethod {
  SYNTHETIC_CHARGILY
  MANUAL_CASH
  MANUAL_POST_TRANSFER
  BARIDIMOB_RECEIPT
}

enum PaymentStatus {
  CREATED
  WAITING_PAYMENT
  WAITING_ADMIN_REVIEW
  PAID
  REJECTED
  FAILED
  CANCELED
  EXPIRED
}

enum PaymentProofDocumentType {
  POST_TRANSFER_PROOF
  BARIDIMOB_RECEIPT
}

enum VerificationStep {
  ESTABLISHMENT_INFO
  LEGAL_INFO
  HEALTH_AUTHORIZATION
  LEGAL_REPRESENTATIVE
  DOCUMENTS
  SUBMISSION
}

enum DoctorVerificationStep {
  IDENTITY
  QUALIFICATION
  PROFESSIONAL_REGISTRATION
  PRACTICE_LOCATION
  FISCAL_SOCIAL
  DOCUMENTS_SUBMISSION
}

enum DoctorType {
  GENERAL_PRACTITIONER
  SPECIALIST
}

enum IdentityDocumentType {
  NATIONAL_ID_CARD
  PASSPORT
  DRIVING_LICENSE
  OTHER
}

enum ProfessionalStatus {
  INDEPENDENT_PRIVATE_DOCTOR
  PRIVATE_INDIVIDUAL_CABINET
  PRIVATE_GROUP_CABINET
  PUBLIC_WITH_COMPLEMENTARY_ACTIVITY
  OTHER
}

enum CabinetType {
  INDIVIDUAL_CABINET
  GROUP_CABINET
  PRIVATE_CONSULTATION
  TELECONSULTATION
  OTHER
}

enum FiscalActivityType {
  MEDICAL_LIBERAL_PROFESSION
  INDIVIDUAL_MEDICAL_CABINET
  GROUP_MEDICAL_CABINET
  OTHER
}

enum VerificationDocumentType {
  COMMERCIAL_REGISTER
  NIF_DOCUMENT
  HEALTH_AUTHORIZATION
  LEGAL_REPRESENTATIVE_ID
  ADDRESS_PROOF
  NIS_DOCUMENT
  COMPANY_STATUTES
  CNAS_CASNOS
  MEDICAL_DIRECTOR_DOCUMENT
  REPRESENTATIVE_NOMINATION
  IDENTITY_DOCUMENT
  MEDICAL_DEGREE
  SPECIALITY_DEGREE
  ORDRE_REGISTRATION
  PRACTICE_AUTHORIZATION
  CABINET_ADDRESS_PROOF
  CASNOS_CERTIFICATE
  CABINET_OPENING_AUTHORIZATION
  PROFESSIONAL_PHOTO
  STAMP_SIGNATURE
  CABINET_OWNERSHIP_OR_RENTAL
  GOOD_STANDING_CERTIFICATE
}

enum VerificationDocumentStatus {
  READY
  UPLOADED
  REJECTED
}

enum PatientGender {
  MALE
  FEMALE
}

enum PatientStatus {
  ACTIVE
  FOLLOW_UP
  NEW
  URGENT
}

enum PatientAdministrativeStatus {
  ACTIVE
  INACTIVE
  DECEASED
}

enum PatientInsurance {
  CNAS
  CASNOS
  UNINSURED
  PRIVATE
}

enum PatientSector {
  PRIVATE
  PUBLIC
  CONVENTIONED
}

// Prisma enum values can't contain "+" or "-". Maps to the frontend's
// PatientBloodGroup display values as: A_POS="A+", A_NEG="A-", B_POS="B+",
// B_NEG="B-", AB_POS="AB+", AB_NEG="AB-", O_POS="O+", O_NEG="O-".
enum PatientBloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum PatientConsentType {
  HEALTH_DATA
  DIAGNOSTIC_AI
  RESEARCH
}

enum PatientConsentStatus {
  SIGNED
  NOT_GRANTED
}

enum PatientDocumentType {
  PRESCRIPTION
  MEDICAL_REPORT
  MEDICAL_IMAGE
  DICOM
  // A 12-lead ECG signal (CSV/TXT or a zipped WFDB record), for the cardiology AI.
  ECG_SIGNAL
}

enum PatientAiAnalysisType {
  MRI
  CT_SCAN
  XRAY
  ECG
}

enum PatientAiAnalysisResult {
  NORMAL
  ANOMALY_DETECTED
}

enum AiAnalysisRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  REJECTED_INPUT
}

enum AiRunDecision {
  VALIDATED
  CORRECTED
  REJECTED
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CANCELED
  COMPLETED
  NO_SHOW
}

enum WorkspaceType {
  ESTABLISHMENT
  PRIVATE_PRACTICE
}

enum WorkspaceMembershipRole {
  OWNER
  ADMIN
  DOCTOR
  RECEPTIONIST
}

enum WorkspaceMembershipStatus {
  ACTIVE
  SUSPENDED
}

// Messaging (docs/messaging-design.md). REFERRAL and SUPPORT are declared
// for the later lots; the API refuses them for now.
enum ConversationType {
  DIRECT
  GROUP
  CASE
  REFERRAL
  SUPPORT
}

enum ParticipantStatus {
  PENDING
  ACTIVE
  LEFT
  BLOCKED
}

enum MessageKind {
  TEXT
  SYSTEM
  ATTACHMENT
}

enum MessagePriority {
  NORMAL
  URGENT
}

// Where a clinical note of the patient record comes from.
enum ClinicalNoteSource {
  MESSAGING
}

enum NotificationCategory {
  APPOINTMENT
  PATIENT
  AI_ANALYSIS
  REPORT
  PRESCRIPTION
  MESSAGING
  VERIFICATION
  SUBSCRIPTION
  PAYMENT
  TEAM
  SECURITY
  SYSTEM
}

enum NotificationSeverity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

enum NotificationResourceType {
  APPOINTMENT
  PATIENT
  AI_ANALYSIS_RUN
  AI_REPORT
  PRESCRIPTION
  CONVERSATION
  VERIFICATION_REQUEST
  PAYMENT
  SUBSCRIPTION
  DOCTOR_PROFILE
  USER
  SYSTEM
}

// Clinical reports center. One row per version of a report: DRAFT while it is
// being written; FINAL once finalized; AMENDED for a finalized version that
// replaces an earlier one; CANCELED with a mandatory reason. The report of an
// AI analysis is FINAL from its creation and is never edited.
enum ClinicalReportStatus {
  DRAFT
  FINAL
  AMENDED
  CANCELED
}

enum ClinicalReportCategory {
  AI_BRAIN
  AI_ECG
  AI_PATHOLOGY
  AI_CARDIAC_MRI
  CONSULTATION_NOTE
  RADIOLOGY
  LABORATORY_RESULT
  EXTERNAL_MEDICAL
  OTHER_CLINICAL
}

enum ClinicalReportSource {
  AI_ANALYSIS
  CONSULTATION
  IMAGING
  LABORATORY
  EXTERNAL_DOCUMENT
  OTHER
}

enum PrescriptionStatus {
  DRAFT
  PENDING_VALIDATION
  VALIDATED
  CANCELED
}

enum PrescriptionType {
  STANDARD
  REGULATED
  PSYCHOTROPIC
  NARCOTIC
}

enum PrescriptionRegulatoryCategory {
  STANDARD
  REGULATED
  PSYCHOTROPIC
  NARCOTIC
}

enum PharmaceuticalForm {
  TABLET
  CAPSULE
  ORAL_SOLUTION
  INJECTABLE
  EYE_DROPS
  OINTMENT
  INHALER
  OTHER
}

enum AdministrationRoute {
  ORAL
  IV
  IM
  SC
  CUTANEOUS
  OPHTHALMIC
  INHALED
  OTHER
}

enum VerificationState {
  YES
  NO
  UNKNOWN
}

model User {
  id                  String        @id @default(cuid())
  fullName            String        @map("full_name") @db.VarChar(120)
  email               String        @unique @db.VarChar(191)
  phone               String        @unique @db.VarChar(32)
  passwordHash        String        @map("password_hash") @db.VarChar(255)
  role                UserRole
  accountStatus       AccountStatus @map("account_status")
  isEmailVerified     Boolean       @default(false) @map("is_email_verified")
  isPhoneVerified     Boolean       @default(false) @map("is_phone_verified")
  // Listed in the messaging directory and reachable by professionals of
  // other workspaces.
  discoverableByPeers Boolean       @default(true) @map("discoverable_by_peers")
  // Read receipts, reciprocal: off, the others no longer see when this user
  // reads, and this user no longer sees when they do.
  shareReadReceipts   Boolean       @default(true) @map("share_read_receipts")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  establishment                  Establishment?
  doctorProfile                  DoctorProfile?
  refreshTokens                  RefreshToken[]
  passwordResetTokens            PasswordResetToken[]
  auditLogs                      AuditLog[]
  verificationRequests           VerificationRequest[]     @relation("VerificationRequestUser")
  reviewedVerificationRequests   VerificationRequest[]     @relation("VerificationReviewedBy")
  subscriptions                  Subscription[]            @relation("SubscriptionUser")
  subscriptionEvents             SubscriptionEvent[]       @relation("SubscriptionEventActor")
  payments                       Payment[]                 @relation("PaymentUser")
  reviewedPayments               Payment[]                 @relation("PaymentReviewedBy")
  recordedPatientConsents        PatientConsent[]
  uploadedPatientDocuments       PatientDocument[]
  requestedPatientAiAnalyses     PatientAiAnalysis[]
  requestedAiAnalysisRuns        AiAnalysisRun[]           @relation("AiAnalysisRunRequestedBy")
  decidedAiAnalysisRuns          AiAnalysisRun[]           @relation("AiAnalysisRunDecidedBy")
  generatedAiAnalysisReports     AiAnalysisReport[]        @relation("AiAnalysisReportGeneratedBy")
  createdAppointments            Appointment[]
  workspaceMemberships           WorkspaceMembership[]
  createdConversations           Conversation[]            @relation("ConversationCreatedBy")
  conversationParticipations     ConversationParticipant[]
  sentMessages                   Message[]                 @relation("MessageSender")
  blocksMade                     UserBlock[]               @relation("UserBlocker")
  blocksReceived                 UserBlock[]               @relation("UserBlocked")
  uploadedMessageAttachments     MessageAttachment[]
  messageAcks                    MessageAck[]
  filedClinicalNotes             PatientClinicalNote[]
  caseConversationViews          CaseConversationView[]
  readMarks                      ConversationReadMark[]
  notifications                  Notification[]
  notificationPreferences        NotificationPreference[]
  createdPrescriptions           Prescription[]            @relation("PrescriptionCreatedBy")
  validatedPrescriptions         Prescription[]            @relation("PrescriptionValidatedBy")
  canceledPrescriptions          Prescription[]            @relation("PrescriptionCanceledBy")
  authoredClinicalReports        ClinicalReport[]          @relation("ClinicalReportAuthor")
  finalizedClinicalReports       ClinicalReport[]          @relation("ClinicalReportFinalizedBy")
  canceledClinicalReports        ClinicalReport[]          @relation("ClinicalReportCanceledBy")
  clinicalReportDocuments        ClinicalReportDocument[]  @relation("ClinicalReportDocumentGeneratedBy")
  generatedPrescriptionDocuments PrescriptionDocument[]    @relation("PrescriptionDocumentGeneratedBy")

  @@map("users")
}

model Establishment {
  id                 String             @id @default(cuid())
  name               String             @db.VarChar(150)
  type               EstablishmentType
  wilaya             String             @db.VarChar(80)
  address            String             @db.VarChar(255)
  professionalEmail  String             @map("professional_email") @db.VarChar(191)
  phone              String             @db.VarChar(32)
  managerFullName    String             @map("manager_full_name") @db.VarChar(120)
  verificationStatus VerificationStatus @map("verification_status")
  subscriptionStatus SubscriptionStatus @map("subscription_status")
  ownerId            String             @unique @map("owner_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  doctorProfiles      DoctorProfile[]
  verificationRequest VerificationRequest?
  patients            Patient[]
  workspace           Workspace?

  @@map("establishments")
}

model DoctorProfile {
  id                  String             @id @default(cuid())
  userId              String             @unique @map("user_id")
  speciality          String             @db.VarChar(100)
  wilaya              String             @db.VarChar(80)
  professionalAddress String             @map("professional_address") @db.VarChar(255)
  isIndependent       Boolean            @default(true) @map("is_independent")
  establishmentId     String?            @map("establishment_id")
  verificationStatus  VerificationStatus @map("verification_status")
  subscriptionStatus  SubscriptionStatus @map("subscription_status")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment       Establishment?        @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  verificationRequest VerificationRequest?
  patients            Patient[]
  consultations       PatientConsultation[]
  appointments        Appointment[]
  ownedWorkspace      Workspace?            @relation("PrivatePracticeWorkspaceOwner")
  prescriptions       Prescription[]

  @@index([establishmentId])
  @@map("doctor_profiles")
}

// establishmentId / doctorProfileId remain temporarily for legacy
// compatibility. workspaceId is the new tenant boundary and stays nullable
// until the backfill has been validated in every deployed environment.
model Patient {
  id                    String                      @id @default(cuid())
  firstName             String                      @map("first_name") @db.VarChar(100)
  firstNameAr           String                      @map("first_name_ar") @db.VarChar(100)
  lastName              String                      @map("last_name") @db.VarChar(100)
  lastNameAr            String                      @map("last_name_ar") @db.VarChar(100)
  gender                PatientGender
  birthDate             DateTime                    @map("birth_date")
  nationalId            String                      @map("national_id") @db.VarChar(64)
  bloodGroup            PatientBloodGroup?          @map("blood_group")
  phone                 String                      @db.VarChar(32)
  email                 String?                     @db.VarChar(191)
  address               String                      @db.VarChar(255)
  wilaya                String                      @db.VarChar(80)
  commune               String                      @db.VarChar(80)
  emergencyContactName  String                      @map("emergency_contact_name") @db.VarChar(120)
  emergencyContactPhone String                      @map("emergency_contact_phone") @db.VarChar(32)
  insurance             PatientInsurance
  insuredNumber         String?                     @map("insured_number") @db.VarChar(64)
  sector                PatientSector
  hospitalRecordNumber  String?                     @map("hospital_record_number") @db.VarChar(80)
  status                PatientStatus               @default(NEW)
  administrativeStatus  PatientAdministrativeStatus @default(ACTIVE) @map("administrative_status")
  smsEnabled            Boolean                     @default(true) @map("sms_enabled")
  // { allergies: string[], chronicDiseases: string[], currentMedications: string[], history: string[], notes: string }
  // (frontend/src/types/patient.ts#PatientMedicalSummary). A single JSON
  // column since MySQL/Prisma has no native array type outside Postgres and
  // this content is never queried field-by-field in SQL.
  medicalSummary        Json?                       @map("medical_summary")
  establishmentId       String?                     @map("establishment_id")
  doctorProfileId       String?                     @map("doctor_profile_id")
  workspaceId           String?                     @map("workspace_id")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")

  establishment   Establishment?        @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  doctorProfile   DoctorProfile?        @relation(fields: [doctorProfileId], references: [id], onDelete: SetNull)
  workspace       Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  consents        PatientConsent[]
  consultations   PatientConsultation[]
  documents       PatientDocument[]
  aiAnalyses      PatientAiAnalysis[]
  aiAnalysisRuns  AiAnalysisRun[]
  appointments    Appointment[]
  conversations   Conversation[]
  clinicalNotes   PatientClinicalNote[]
  prescriptions   Prescription[]
  clinicalReports ClinicalReport[]

  @@index([establishmentId])
  @@index([doctorProfileId])
  @@index([workspaceId])
  @@map("patients")
}

model Workspace {
  id                   String        @id @default(cuid())
  type                 WorkspaceType
  name                 String        @db.VarChar(150)
  establishmentId      String?       @unique @map("establishment_id")
  ownerDoctorProfileId String?       @unique @map("owner_doctor_profile_id")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  establishment      Establishment?        @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  ownerDoctorProfile DoctorProfile?        @relation("PrivatePracticeWorkspaceOwner", fields: [ownerDoctorProfileId], references: [id], onDelete: SetNull)
  memberships        WorkspaceMembership[]
  patients           Patient[]
  conversations      Conversation[]
  notifications      Notification[]
  prescriptions      Prescription[]
  clinicalReports    ClinicalReport[]

  @@index([type])
  @@index([establishmentId])
  @@index([ownerDoctorProfileId])
  @@map("workspaces")
}

model WorkspaceMembership {
  id          String                    @id @default(cuid())
  workspaceId String                    @map("workspace_id")
  userId      String                    @map("user_id")
  role        WorkspaceMembershipRole
  status      WorkspaceMembershipStatus @default(ACTIVE)
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
  @@index([workspaceId])
  @@map("workspace_memberships")
}

// A consent is its own record per purpose (type + status + timestamp + who
// recorded it), never a single boolean flag — see "Le consentement doit
// devenir un objet distinct" in reports/Module patients SaaS médical Algérie.md.
// @@unique([patientId, type]) means each purpose is updated over time rather
// than duplicated into a new row.
model PatientConsent {
  id           String               @id @default(cuid())
  patientId    String               @map("patient_id")
  type         PatientConsentType
  status       PatientConsentStatus
  documentName String?              @map("document_name") @db.VarChar(255)
  recordedAt   DateTime             @map("recorded_at")
  recordedById String               @map("recorded_by_id")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy User    @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([patientId, type])
  @@index([patientId])
  @@index([recordedById])
  @@map("patient_consents")
}

model PatientConsultation {
  id              String   @id @default(cuid())
  patientId       String   @map("patient_id")
  doctorProfileId String?  @map("doctor_profile_id")
  appointmentId   String?  @unique @map("appointment_id")
  date            DateTime
  reason          String   @db.Text
  diagnosis       String   @db.Text
  treatment       String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  patient         Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorProfile   DoctorProfile?   @relation(fields: [doctorProfileId], references: [id], onDelete: SetNull)
  appointment     Appointment?     @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  prescriptions   Prescription[]
  clinicalReports ClinicalReport[]

  @@index([patientId])
  @@map("patient_consultations")
}

model PatientDocument {
  id             String              @id @default(cuid())
  patientId      String              @map("patient_id")
  documentType   PatientDocumentType @map("document_type")
  originalName   String              @map("original_name") @db.VarChar(255)
  storedName     String              @map("stored_name") @db.VarChar(255)
  mimeType       String              @map("mime_type") @db.VarChar(100)
  size           Int
  localPath      String              @map("local_path") @db.VarChar(500)
  checksum       String?             @db.VarChar(128)
  uploadedById   String              @map("uploaded_by_id")
  prescriptionId String?             @unique @map("prescription_id")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  patient            Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedBy         User                @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  aiAnalyses         PatientAiAnalysis[]
  aiAnalysisRuns     AiAnalysisRun[]
  messageAttachments MessageAttachment[]
  prescription       Prescription?       @relation(fields: [prescriptionId], references: [id], onDelete: Restrict)
  clinicalReport     ClinicalReport?

  @@index([patientId])
  @@map("patient_documents")
}

// This step only lays down the structure that will receive AI model output
// later (modelName/modelVersion trace which model produced the result).
// It does not call any real inference model — result/score are recorded
// manually for now.
model PatientAiAnalysis {
  id               String                  @id @default(cuid())
  patientId        String                  @map("patient_id")
  type             PatientAiAnalysisType
  result           PatientAiAnalysisResult
  score            Float
  modelName        String                  @map("model_name") @db.VarChar(120)
  modelVersion     String?                 @map("model_version") @db.VarChar(40)
  sourceDocumentId String?                 @map("source_document_id")
  requestedById    String                  @map("requested_by_id")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  patient        Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sourceDocument PatientDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  requestedBy    User             @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@map("patient_ai_analyses")
}

model Appointment {
  id              String            @id @default(cuid())
  patientId       String            @map("patient_id")
  doctorProfileId String            @map("doctor_profile_id")
  scheduledAt     DateTime          @map("scheduled_at")
  durationMinutes Int               @default(30) @map("duration_minutes")
  reason          String            @db.VarChar(255)
  status          AppointmentStatus @default(SCHEDULED)
  notes           String?           @db.Text
  createdById     String            @map("created_by_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  patient       Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorProfile DoctorProfile        @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  createdBy     User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  consultation  PatientConsultation?

  @@index([patientId])
  @@index([doctorProfileId])
  @@index([scheduledAt])
  @@map("appointments")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id")
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("audit_logs")
}

// Internal medication reference. Sources are descriptive provenance only;
// they do not imply ANPP/CNAS verification.
model MedicationReference {
  id                    String                         @id @default(cuid())
  dci                   String                         @db.VarChar(160)
  brandName             String?                        @map("brand_name") @db.VarChar(160)
  strength              String                         @db.VarChar(120)
  pharmaceuticalForm    PharmaceuticalForm             @map("pharmaceutical_form")
  route                 AdministrationRoute
  manufacturer          String?                        @db.VarChar(160)
  regulatoryCategory    PrescriptionRegulatoryCategory @map("regulatory_category")
  reimbursable          VerificationState              @default(UNKNOWN)
  requiresPriorApproval VerificationState              @default(UNKNOWN) @map("requires_prior_approval")
  source                String                         @db.VarChar(40)
  sourceReference       String?                        @map("source_reference") @db.VarChar(191)
  active                Boolean                        @default(true)
  createdAt             DateTime                       @default(now()) @map("created_at")

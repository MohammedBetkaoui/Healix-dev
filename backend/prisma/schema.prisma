// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  SUPER_ADMIN
  ADMIN_VERIFICATION
  ESTABLISHMENT_ADMIN
  AFFILIATED_DOCTOR
  INDEPENDENT_DOCTOR
}

enum AccountStatus {
  BASIC_ACCOUNT
  PENDING_VERIFICATION
  VERIFIED_NO_PLAN
  PAYMENT_PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum EstablishmentType {
  CLINIC
  HOSPITAL
  IMAGING_CENTER
  LABORATORY
  GROUP_PRACTICE
}

enum VerificationStatus {
  NOT_STARTED
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
  SUSPENDED
}

enum SubscriptionStatus {
  NO_PLAN
  PAYMENT_PENDING
  ACTIVE
  EXPIRED
  CANCELED
}

enum VerificationRequestType {
  ESTABLISHMENT
  INDEPENDENT_DOCTOR
}

enum AccountType {
  ESTABLISHMENT
  INDEPENDENT_DOCTOR
}

enum BillingPeriod {
  MONTHLY
  ANNUAL
}

enum PaymentMethod {
  SYNTHETIC_CHARGILY
  MANUAL_CASH
  MANUAL_POST_TRANSFER
  BARIDIMOB_RECEIPT
}

enum PaymentStatus {
  CREATED
  WAITING_PAYMENT
  WAITING_ADMIN_REVIEW
  PAID
  REJECTED
  FAILED
  CANCELED
  EXPIRED
}

enum PaymentProofDocumentType {
  POST_TRANSFER_PROOF
  BARIDIMOB_RECEIPT
}

enum VerificationStep {
  ESTABLISHMENT_INFO
  LEGAL_INFO
  HEALTH_AUTHORIZATION
  LEGAL_REPRESENTATIVE
  DOCUMENTS
  SUBMISSION
}

enum DoctorVerificationStep {
  IDENTITY
  QUALIFICATION
  PROFESSIONAL_REGISTRATION
  PRACTICE_LOCATION
  FISCAL_SOCIAL
  DOCUMENTS_SUBMISSION
}

enum DoctorType {
  GENERAL_PRACTITIONER
  SPECIALIST
}

enum IdentityDocumentType {
  NATIONAL_ID_CARD
  PASSPORT
  DRIVING_LICENSE
  OTHER
}

enum ProfessionalStatus {
  INDEPENDENT_PRIVATE_DOCTOR
  PRIVATE_INDIVIDUAL_CABINET
  PRIVATE_GROUP_CABINET
  PUBLIC_WITH_COMPLEMENTARY_ACTIVITY
  OTHER
}

enum CabinetType {
  INDIVIDUAL_CABINET
  GROUP_CABINET
  PRIVATE_CONSULTATION
  TELECONSULTATION
  OTHER
}

enum FiscalActivityType {
  MEDICAL_LIBERAL_PROFESSION
  INDIVIDUAL_MEDICAL_CABINET
  GROUP_MEDICAL_CABINET
  OTHER
}

enum VerificationDocumentType {
  COMMERCIAL_REGISTER
  NIF_DOCUMENT
  HEALTH_AUTHORIZATION
  LEGAL_REPRESENTATIVE_ID
  ADDRESS_PROOF
  NIS_DOCUMENT
  COMPANY_STATUTES
  CNAS_CASNOS
  MEDICAL_DIRECTOR_DOCUMENT
  REPRESENTATIVE_NOMINATION
  IDENTITY_DOCUMENT
  MEDICAL_DEGREE
  SPECIALITY_DEGREE
  ORDRE_REGISTRATION
  PRACTICE_AUTHORIZATION
  CABINET_ADDRESS_PROOF
  CASNOS_CERTIFICATE
  CABINET_OPENING_AUTHORIZATION
  PROFESSIONAL_PHOTO
  STAMP_SIGNATURE
  CABINET_OWNERSHIP_OR_RENTAL
  GOOD_STANDING_CERTIFICATE
}

enum VerificationDocumentStatus {
  READY
  UPLOADED
  REJECTED
}

enum PatientGender {
  MALE
  FEMALE
}

enum PatientStatus {
  ACTIVE
  FOLLOW_UP
  NEW
  URGENT
}

enum PatientAdministrativeStatus {
  ACTIVE
  INACTIVE
  DECEASED
}

enum PatientInsurance {
  CNAS
  CASNOS
  UNINSURED
  PRIVATE
}

enum PatientSector {
  PRIVATE
  PUBLIC
  CONVENTIONED
}

// Prisma enum values can't contain "+" or "-". Maps to the frontend's
// PatientBloodGroup display values as: A_POS="A+", A_NEG="A-", B_POS="B+",
// B_NEG="B-", AB_POS="AB+", AB_NEG="AB-", O_POS="O+", O_NEG="O-".
enum PatientBloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
}

enum PatientConsentType {
  HEALTH_DATA
  DIAGNOSTIC_AI
  RESEARCH
}

enum PatientConsentStatus {
  SIGNED
  NOT_GRANTED
}

enum PatientDocumentType {
  PRESCRIPTION
  MEDICAL_REPORT
  MEDICAL_IMAGE
  DICOM
}

enum PatientAiAnalysisType {
  MRI
  CT_SCAN
  XRAY
  ECG
}

enum PatientAiAnalysisResult {
  NORMAL
  ANOMALY_DETECTED
}

model User {
  id              String        @id @default(cuid())
  fullName        String        @map("full_name") @db.VarChar(120)
  email           String        @unique @db.VarChar(191)
  phone           String        @unique @db.VarChar(32)
  passwordHash    String        @map("password_hash") @db.VarChar(255)
  role            UserRole
  accountStatus   AccountStatus @map("account_status")
  isEmailVerified Boolean       @default(false) @map("is_email_verified")
  isPhoneVerified Boolean       @default(false) @map("is_phone_verified")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  establishment                Establishment?
  doctorProfile                DoctorProfile?
  refreshTokens                RefreshToken[]
  auditLogs                    AuditLog[]
  verificationRequests         VerificationRequest[] @relation("VerificationRequestUser")
  reviewedVerificationRequests VerificationRequest[] @relation("VerificationReviewedBy")
  subscriptions                Subscription[]        @relation("SubscriptionUser")
  payments                     Payment[]             @relation("PaymentUser")
  reviewedPayments             Payment[]             @relation("PaymentReviewedBy")
  recordedPatientConsents      PatientConsent[]
  uploadedPatientDocuments     PatientDocument[]
  requestedPatientAiAnalyses   PatientAiAnalysis[]

  @@map("users")
}

model Establishment {
  id                 String             @id @default(cuid())
  name               String             @db.VarChar(150)
  type               EstablishmentType
  wilaya             String             @db.VarChar(80)
  address            String             @db.VarChar(255)
  professionalEmail  String             @map("professional_email") @db.VarChar(191)
  phone              String             @db.VarChar(32)
  managerFullName    String             @map("manager_full_name") @db.VarChar(120)
  verificationStatus VerificationStatus @map("verification_status")
  subscriptionStatus SubscriptionStatus @map("subscription_status")
  ownerId            String             @unique @map("owner_id")
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")

  owner               User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  doctorProfiles      DoctorProfile[]
  verificationRequest VerificationRequest?
  patients            Patient[]

  @@map("establishments")
}

model DoctorProfile {
  id                  String             @id @default(cuid())
  userId              String             @unique @map("user_id")
  speciality          String             @db.VarChar(100)
  wilaya              String             @db.VarChar(80)
  professionalAddress String             @map("professional_address") @db.VarChar(255)
  isIndependent       Boolean            @default(true) @map("is_independent")
  establishmentId     String?            @map("establishment_id")
  verificationStatus  VerificationStatus @map("verification_status")
  subscriptionStatus  SubscriptionStatus @map("subscription_status")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  establishment       Establishment?       @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  verificationRequest VerificationRequest?
  patients            Patient[]
  consultations       PatientConsultation[]

  @@index([establishmentId])
  @@map("doctor_profiles")
}

// Exactly one of establishmentId / doctorProfileId must be set: the patient
// record belongs either to an establishment or to the independent/affiliated
// doctor who created it. This is an application-level rule, not a SQL
// constraint — Prisma has no native XOR support across nullable relations.
model Patient {
  id                    String                      @id @default(cuid())
  firstName             String                      @map("first_name") @db.VarChar(100)
  firstNameAr           String                      @map("first_name_ar") @db.VarChar(100)
  lastName              String                      @map("last_name") @db.VarChar(100)
  lastNameAr            String                      @map("last_name_ar") @db.VarChar(100)
  gender                PatientGender
  birthDate             DateTime                    @map("birth_date")
  nationalId            String                      @map("national_id") @db.VarChar(64)
  bloodGroup            PatientBloodGroup?          @map("blood_group")
  phone                 String                      @db.VarChar(32)
  email                 String?                     @db.VarChar(191)
  address               String                      @db.VarChar(255)
  wilaya                String                      @db.VarChar(80)
  commune               String                      @db.VarChar(80)
  emergencyContactName  String                      @map("emergency_contact_name") @db.VarChar(120)
  emergencyContactPhone String                      @map("emergency_contact_phone") @db.VarChar(32)
  insurance             PatientInsurance
  insuredNumber         String?                     @map("insured_number") @db.VarChar(64)
  sector                PatientSector
  hospitalRecordNumber  String?                     @map("hospital_record_number") @db.VarChar(80)
  status                PatientStatus               @default(NEW)
  administrativeStatus  PatientAdministrativeStatus @default(ACTIVE) @map("administrative_status")
  smsEnabled            Boolean                     @default(true) @map("sms_enabled")
  // { allergies: string[], chronicDiseases: string[], currentMedications: string[], history: string[], notes: string }
  // (frontend/src/types/patient.ts#PatientMedicalSummary). A single JSON
  // column since MySQL/Prisma has no native array type outside Postgres and
  // this content is never queried field-by-field in SQL.
  medicalSummary        Json?                       @map("medical_summary")
  establishmentId       String?                     @map("establishment_id")
  doctorProfileId       String?                     @map("doctor_profile_id")
  createdAt             DateTime                    @default(now()) @map("created_at")
  updatedAt             DateTime                    @updatedAt @map("updated_at")

  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)
  doctorProfile DoctorProfile? @relation(fields: [doctorProfileId], references: [id], onDelete: SetNull)
  consents      PatientConsent[]
  consultations PatientConsultation[]
  documents     PatientDocument[]
  aiAnalyses    PatientAiAnalysis[]

  @@index([establishmentId])
  @@index([doctorProfileId])
  @@map("patients")
}

// A consent is its own record per purpose (type + status + timestamp + who
// recorded it), never a single boolean flag — see "Le consentement doit
// devenir un objet distinct" in reports/Module patients SaaS médical Algérie.md.
// @@unique([patientId, type]) means each purpose is updated over time rather
// than duplicated into a new row.
model PatientConsent {
  id           String               @id @default(cuid())
  patientId    String               @map("patient_id")
  type         PatientConsentType
  status       PatientConsentStatus
  documentName String?              @map("document_name") @db.VarChar(255)
  recordedAt   DateTime             @map("recorded_at")
  recordedById String               @map("recorded_by_id")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  patient    Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedBy User    @relation(fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([patientId, type])
  @@index([patientId])
  @@index([recordedById])
  @@map("patient_consents")
}

model PatientConsultation {
  id              String   @id @default(cuid())
  patientId       String   @map("patient_id")
  doctorProfileId String?  @map("doctor_profile_id")
  date            DateTime
  reason          String   @db.Text
  diagnosis       String   @db.Text
  treatment       String   @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  patient       Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorProfile DoctorProfile? @relation(fields: [doctorProfileId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@map("patient_consultations")
}

model PatientDocument {
  id           String              @id @default(cuid())
  patientId    String              @map("patient_id")
  documentType PatientDocumentType @map("document_type")
  originalName String              @map("original_name") @db.VarChar(255)
  storedName   String              @map("stored_name") @db.VarChar(255)
  mimeType     String              @map("mime_type") @db.VarChar(100)
  size         Int
  localPath    String              @map("local_path") @db.VarChar(500)
  checksum     String?             @db.VarChar(128)
  uploadedById String              @map("uploaded_by_id")
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")

  patient    Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  uploadedBy User                @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  aiAnalyses PatientAiAnalysis[]

  @@index([patientId])
  @@map("patient_documents")
}

// This step only lays down the structure that will receive AI model output
// later (modelName/modelVersion trace which model produced the result).
// It does not call any real inference model — result/score are recorded
// manually for now.
model PatientAiAnalysis {
  id               String                  @id @default(cuid())
  patientId        String                  @map("patient_id")
  type             PatientAiAnalysisType
  result           PatientAiAnalysisResult
  score            Float
  modelName        String                  @map("model_name") @db.VarChar(120)
  modelVersion     String?                 @map("model_version") @db.VarChar(40)
  sourceDocumentId String?                 @map("source_document_id")
  requestedById    String                  @map("requested_by_id")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  patient        Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sourceDocument PatientDocument? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  requestedBy    User             @relation(fields: [requestedById], references: [id], onDelete: Restrict)

  @@index([patientId])
  @@map("patient_ai_analyses")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String   @db.VarChar(120)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String?  @map("entity_id")
  ipAddress  String?  @map("ip_address") @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(255)
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash") @db.Text
  userAgent String?   @map("user_agent") @db.VarChar(255)
  ipAddress String?   @map("ip_address") @db.VarChar(64)
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model VerificationRequest {
  id                String                  @id @default(cuid())
  establishmentId   String?                 @unique @map("establishment_id")
  doctorProfileId   String?                 @unique @map("doctor_profile_id")
  userId            String                  @map("user_id")
  type              VerificationRequestType @default(ESTABLISHMENT)
  status            VerificationStatus      @default(DRAFT)
  currentStep       VerificationStep        @default(ESTABLISHMENT_INFO) @map("current_step")
  doctorCurrentStep DoctorVerificationStep? @map("doctor_current_step")
  submittedAt       DateTime?               @map("submitted_at")
  reviewedAt        DateTime?               @map("reviewed_at")
  reviewedById      String?                 @map("reviewed_by_id")
  rejectionReason   String?                 @map("rejection_reason") @db.Text
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  establishment Establishment?                 @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  doctorProfile DoctorProfile?                 @relation(fields: [doctorProfileId], references: [id], onDelete: Cascade)
  user          User                           @relation("VerificationRequestUser", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy    User?                          @relation("VerificationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  data          EstablishmentVerificationData?
  doctorData    DoctorVerificationData?
  documents     VerificationDocument[]

  @@index([doctorProfileId])
  @@index([userId])
  @@index([reviewedById])
  @@index([status])
  @@map("verification_requests")
}

model EstablishmentVerificationData {
  id                           String            @id @default(cuid())
  verificationRequestId        String            @unique @map("verification_request_id")
  name                         String            @db.VarChar(150)
  type                         EstablishmentType
  legalForm                    String?           @map("legal_form") @db.VarChar(120)
  wilaya                       String            @db.VarChar(80)
  commune                      String?           @db.VarChar(80)
  address                      String            @db.VarChar(255)
  phone                        String            @db.VarChar(32)
  professionalEmail            String            @map("professional_email") @db.VarChar(191)
  website                      String?           @db.VarChar(191)
  commercialRegisterNumber     String?           @map("commercial_register_number") @db.VarChar(80)
  commercialRegisterIssuedAt   DateTime?         @map("commercial_register_issued_at")
  commercialRegisterWilaya     String?           @map("commercial_register_wilaya") @db.VarChar(80)
  nif                          String?           @db.VarChar(80)
  nis                          String?           @db.VarChar(80)
  taxCenter                    String?           @map("tax_center") @db.VarChar(120)
  healthAuthorizationNumber    String?           @map("health_authorization_number") @db.VarChar(100)
  healthAuthorizationIssuedAt  DateTime?         @map("health_authorization_issued_at")
  healthAuthorizationAuthority String?           @map("health_authorization_authority") @db.VarChar(160)
  healthDirectionWilaya        String?           @map("health_direction_wilaya") @db.VarChar(80)
  authorizedActivityType       String?           @map("authorized_activity_type") @db.VarChar(160)
  legalRepresentativeFullName  String?           @map("legal_representative_full_name") @db.VarChar(120)
  legalRepresentativeFunction  String?           @map("legal_representative_function") @db.VarChar(120)
  legalRepresentativeNinOrId   String?           @map("legal_representative_nin_or_id") @db.VarChar(80)
  legalRepresentativePhone     String?           @map("legal_representative_phone") @db.VarChar(32)
  legalRepresentativeEmail     String?           @map("legal_representative_email") @db.VarChar(191)
  confirmationAccuracy         Boolean           @default(false) @map("confirmation_accuracy")
  createdAt                    DateTime          @default(now()) @map("created_at")
  updatedAt                    DateTime          @updatedAt @map("updated_at")

  verificationRequest VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  @@map("establishment_verification_data")
}

model DoctorVerificationData {
  id                          String                @id @default(cuid())
  verificationRequestId       String                @unique @map("verification_request_id")
  fullName                    String                @map("full_name") @db.VarChar(120)
  birthDate                   DateTime?             @map("birth_date")
  birthPlace                  String?               @map("birth_place") @db.VarChar(120)
  nationality                 String?               @db.VarChar(80)
  ninOrIdNumber               String?               @map("nin_or_id_number") @db.VarChar(80)
  identityDocumentType        IdentityDocumentType? @map("identity_document_type")
  phone                       String                @db.VarChar(32)
  professionalEmail           String                @map("professional_email") @db.VarChar(191)
  wilaya                      String                @db.VarChar(80)
  commune                     String?               @db.VarChar(80)
  address                     String?               @db.VarChar(255)
  doctorType                  DoctorType?           @map("doctor_type")
  speciality                  String                @db.VarChar(100)
  mainDegree                  String?               @map("main_degree") @db.VarChar(160)
  university                  String?               @db.VarChar(160)
  graduationYear              Int?                  @map("graduation_year")
  specialityDegree            String?               @map("speciality_degree") @db.VarChar(160)
  specialityGraduationYear    Int?                  @map("speciality_graduation_year")
  orderRegistrationNumber     String?               @map("order_registration_number") @db.VarChar(100)
  regionalCouncil             String?               @map("regional_council") @db.VarChar(160)
  registrationWilaya          String?               @map("registration_wilaya") @db.VarChar(80)
  registrationDate            DateTime?             @map("registration_date")
  professionalStatus          ProfessionalStatus?   @map("professional_status")
  practiceAuthorizationNumber String?               @map("practice_authorization_number") @db.VarChar(100)
  authorizationAuthority      String?               @map("authorization_authority") @db.VarChar(160)
  cabinetName                 String?               @map("cabinet_name") @db.VarChar(160)
  cabinetType                 CabinetType?          @map("cabinet_type")
  cabinetAddress              String?               @map("cabinet_address") @db.VarChar(255)
  cabinetWilaya               String?               @map("cabinet_wilaya") @db.VarChar(80)
  cabinetCommune              String?               @map("cabinet_commune") @db.VarChar(80)
  cabinetPhone                String?               @map("cabinet_phone") @db.VarChar(32)
  cabinetEmail                String?               @map("cabinet_email") @db.VarChar(191)
  healthDirectionWilaya       String?               @map("health_direction_wilaya") @db.VarChar(80)
  cabinetOpeningAuthorization String?               @map("cabinet_opening_authorization") @db.VarChar(120)
  nif                         String?               @db.VarChar(80)
  taxCenter                   String?               @map("tax_center") @db.VarChar(120)
  casnosNumber                String?               @map("casnos_number") @db.VarChar(80)
  fiscalActivityType          FiscalActivityType?   @map("fiscal_activity_type")
  professionalRib             String?               @map("professional_rib") @db.VarChar(80)
  confirmationAccuracy        Boolean               @default(false) @map("confirmation_accuracy")
  createdAt                   DateTime              @default(now()) @map("created_at")
  updatedAt                   DateTime              @updatedAt @map("updated_at")

  verificationRequest VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  @@map("doctor_verification_data")
}

model VerificationDocument {
  id                    String                     @id @default(cuid())
  verificationRequestId String                     @map("verification_request_id")
  documentType          VerificationDocumentType   @map("document_type")
  originalName          String                     @map("original_name") @db.VarChar(255)
  storedName            String                     @map("stored_name") @db.VarChar(255)
  mimeType              String                     @map("mime_type") @db.VarChar(100)
  size                  Int
  localPath             String                     @map("local_path") @db.VarChar(500)
  checksum              String?                    @db.VarChar(128)
  status                VerificationDocumentStatus @default(UPLOADED)
  uploadedAt            DateTime                   @default(now()) @map("uploaded_at")
  createdAt             DateTime                   @default(now()) @map("created_at")
  updatedAt             DateTime                   @updatedAt @map("updated_at")

  verificationRequest VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  @@unique([verificationRequestId, documentType])
  @@index([verificationRequestId])
  @@map("verification_documents")
}

model SubscriptionPlan {
  id           String      @id @default(cuid())
  name         String      @db.VarChar(120)
  code         String      @unique @db.VarChar(80)
  accountType  AccountType @map("account_type")
  description  String?     @db.Text
  monthlyPrice Int?        @map("monthly_price")
  annualPrice  Int?        @map("annual_price")
  currency     String      @default("DZD") @db.VarChar(8)
  features     Json?
  limits       Json?
  recommended  Boolean     @default(false)
  custom       Boolean     @default(false)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  subscriptions Subscription[]
  payments      Payment[]

  @@index([accountType])
  @@index([active])
  @@map("subscription_plans")
}

model Subscription {
  id            String             @id @default(cuid())
  userId        String             @map("user_id")
  planId        String             @map("plan_id")
  accountType   AccountType        @map("account_type")
  status        SubscriptionStatus
  billingPeriod BillingPeriod      @map("billing_period")
  startedAt     DateTime?          @map("started_at")
  expiresAt     DateTime?          @map("expires_at")
  canceledAt    DateTime?          @map("canceled_at")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  user     User             @relation("SubscriptionUser", fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan @relation(fields: [planId], references: [id])
  payments Payment[]

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

model Payment {
  id                String        @id @default(cuid())
  userId            String        @map("user_id")
  subscriptionId    String?       @map("subscription_id")
  planId            String        @map("plan_id")
  accountType       AccountType   @map("account_type")
  method            PaymentMethod
  status            PaymentStatus
  amount            Int
  currency          String        @default("DZD") @db.VarChar(8)
  billingPeriod     BillingPeriod @map("billing_period")
  reference         String        @unique @db.VarChar(80)
  provider          String?       @db.VarChar(80)
  providerPaymentId String?       @map("provider_payment_id") @db.VarChar(120)
  providerStatus    String?       @map("provider_status") @db.VarChar(80)
  syntheticMode     Boolean       @default(true) @map("synthetic_mode")
  cardLast4         String?       @map("card_last4") @db.VarChar(4)
  cardHolderName    String?       @map("card_holder_name") @db.VarChar(120)
  proofDocumentId   String?       @map("proof_document_id")
  adminNote         String?       @map("admin_note") @db.Text
  rejectionReason   String?       @map("rejection_reason") @db.Text
  paidAt            DateTime?     @map("paid_at")
  reviewedAt        DateTime?     @map("reviewed_at")
  reviewedById      String?       @map("reviewed_by_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user          User                  @relation("PaymentUser", fields: [userId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan      @relation(fields: [planId], references: [id])
  subscription  Subscription?         @relation(fields: [subscriptionId], references: [id])
  reviewedBy    User?                 @relation("PaymentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  proofDocument PaymentProofDocument?

  @@index([userId])
  @@index([subscriptionId])
  @@index([planId])
  @@index([status])
  @@index([method])
  @@index([reviewedById])
  @@map("payments")
}

model PaymentProofDocument {
  id           String                   @id @default(cuid())
  paymentId    String                   @unique @map("payment_id")
  documentType PaymentProofDocumentType @map("document_type")
  originalName String                   @map("original_name") @db.VarChar(255)
  storedName   String                   @map("stored_name") @db.VarChar(255)
  mimeType     String                   @map("mime_type") @db.VarChar(100)
  size         Int
  localPath    String                   @map("local_path") @db.VarChar(500)
  checksum     String?                  @db.VarChar(128)
  uploadedAt   DateTime                 @default(now()) @map("uploaded_at")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_proof_documents")
}

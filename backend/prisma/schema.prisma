model SubscriptionPlan {
  id           String      @id @default(cuid())
  name         String      @db.VarChar(120)
  code         String      @unique @db.VarChar(80)
  accountType  AccountType @map("account_type")
  description  String?     @db.Text
  monthlyPrice Int?        @map("monthly_price")
  annualPrice  Int?        @map("annual_price")
  currency     String      @default("DZD") @db.VarChar(8)
  features     Json?
  // Display texts ("100 patients"); the numbers the platform enforces are in
  // `quotas`, and a test keeps both in agreement.
  limits       Json?
  // { maxPatients, aiAnalysesPerMonth, maxDoctors, aiPipelines }: null is
  // unlimited, and aiPipelines null is every pipeline (see
  // subscriptions/plans/plan-quotas.ts).
  quotas       Json
  recommended  Boolean     @default(false)
  custom       Boolean     @default(false)
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  subscriptions  Subscription[]
  payments       Payment[]
  eventsFromPlan SubscriptionEvent[] @relation("SubscriptionEventFromPlan")
  eventsToPlan   SubscriptionEvent[] @relation("SubscriptionEventToPlan")

  @@index([accountType])
  @@index([active])
  @@map("subscription_plans")
}

model Subscription {
  id            String             @id @default(cuid())
  userId        String             @map("user_id")
  planId        String             @map("plan_id")
  accountType   AccountType        @map("account_type")
  status        SubscriptionStatus
  billingPeriod BillingPeriod      @map("billing_period")
  // startedAt: the start of the current regime (the trial, the paid period
  // after the trial or after a lapse). A renewal or a plan change keeps it:
  // the AI quota counts from it.
  startedAt     DateTime?          @map("started_at")
  expiresAt     DateTime?          @map("expires_at")
  canceledAt    DateTime?          @map("canceled_at")
  // The free trial: quotas of the trial, whatever the reference plan says.
  trial         Boolean            @default(false)
  // Fixed by an administrator: replaces the quotas of the plan (and of the
  // trial) while it is set.
  customQuotas  Json?              @map("custom_quotas")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")

  user     User                @relation("SubscriptionUser", fields: [userId], references: [id], onDelete: Cascade)
  plan     SubscriptionPlan    @relation(fields: [planId], references: [id])
  payments Payment[]
  events   SubscriptionEvent[]

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@map("subscriptions")
}

// The history of a subscription: what changed, from what to what, because of
// which payment or which administrator, and why.
model SubscriptionEvent {
  id             String                @id @default(cuid())
  subscriptionId String                @map("subscription_id")
  type           SubscriptionEventType
  fromStatus     SubscriptionStatus?   @map("from_status")
  toStatus       SubscriptionStatus?   @map("to_status")
  fromPlanId     String?               @map("from_plan_id")
  toPlanId       String?               @map("to_plan_id")
  fromExpiresAt  DateTime?             @map("from_expires_at")
  toExpiresAt    DateTime?             @map("to_expires_at")
  paymentId      String?               @map("payment_id")
  actorId        String?               @map("actor_id")
  reason         String?               @db.Text
  createdAt      DateTime              @default(now()) @map("created_at")

  subscription Subscription      @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  fromPlan     SubscriptionPlan? @relation("SubscriptionEventFromPlan", fields: [fromPlanId], references: [id], onDelete: SetNull)
  toPlan       SubscriptionPlan? @relation("SubscriptionEventToPlan", fields: [toPlanId], references: [id], onDelete: SetNull)
  payment      Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  actor        User?             @relation("SubscriptionEventActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([subscriptionId, createdAt])
  @@index([fromPlanId])
  @@index([toPlanId])
  @@index([paymentId])
  @@index([actorId])
  @@map("subscription_events")
}

// In-app attention signals only. Clinical detail stays on the protected
// resource and is deliberately never copied into this table.
model Notification {
  id           String                    @id @default(cuid())
  userId       String                    @map("user_id")
  workspaceId  String?                   @map("workspace_id")
  category     NotificationCategory
  type         String                    @db.VarChar(100)
  severity     NotificationSeverity      @default(INFO)
  resourceType NotificationResourceType? @map("resource_type")
  resourceId   String?                   @map("resource_id") @db.VarChar(191)
  data         Json?
  dedupeKey    String?                   @map("dedupe_key") @db.VarChar(191)
  readAt       DateTime?                 @map("read_at")
  archivedAt   DateTime?                 @map("archived_at")
  createdAt    DateTime                  @default(now()) @map("created_at")
  updatedAt    DateTime                  @updatedAt @map("updated_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@unique([userId, dedupeKey])
  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([workspaceId])
  @@index([category])
  @@index([resourceType, resourceId])
  @@map("notifications")
}

model NotificationPreference {
  id           String               @id @default(cuid())
  userId       String               @map("user_id")
  category     NotificationCategory
  inAppEnabled Boolean              @default(true) @map("in_app_enabled")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category])
  @@map("notification_preferences")
}

model Payment {
  id                String        @id @default(cuid())
  userId            String        @map("user_id")
  subscriptionId    String?       @map("subscription_id")
  planId            String        @map("plan_id")
  accountType       AccountType   @map("account_type")
  method            PaymentMethod
  status            PaymentStatus
  amount            Int
  currency          String        @default("DZD") @db.VarChar(8)
  billingPeriod     BillingPeriod @map("billing_period")
  reference         String        @unique @db.VarChar(80)
  provider          String?       @db.VarChar(80)
  providerPaymentId String?       @map("provider_payment_id") @db.VarChar(120)
  providerStatus    String?       @map("provider_status") @db.VarChar(80)
  syntheticMode     Boolean       @default(true) @map("synthetic_mode")
  cardLast4         String?       @map("card_last4") @db.VarChar(4)
  cardHolderName    String?       @map("card_holder_name") @db.VarChar(120)
  proofDocumentId   String?       @map("proof_document_id")
  adminNote         String?       @map("admin_note") @db.Text
  rejectionReason   String?       @map("rejection_reason") @db.Text
  paidAt            DateTime?     @map("paid_at")
  reviewedAt        DateTime?     @map("reviewed_at")
  reviewedById      String?       @map("reviewed_by_id")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  user               User                  @relation("PaymentUser", fields: [userId], references: [id], onDelete: Cascade)
  plan               SubscriptionPlan      @relation(fields: [planId], references: [id])
  subscription       Subscription?         @relation(fields: [subscriptionId], references: [id])
  reviewedBy         User?                 @relation("PaymentReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  proofDocument      PaymentProofDocument?
  subscriptionEvents SubscriptionEvent[]

  @@index([userId])
  @@index([subscriptionId])
  @@index([planId])
  @@index([status])
  @@index([method])
  @@index([reviewedById])
  @@map("payments")
}

model PaymentProofDocument {
  id           String                   @id @default(cuid())
  paymentId    String                   @unique @map("payment_id")
  documentType PaymentProofDocumentType @map("document_type")
  originalName String                   @map("original_name") @db.VarChar(255)
  storedName   String                   @map("stored_name") @db.VarChar(255)
  mimeType     String                   @map("mime_type") @db.VarChar(100)
  size         Int
  localPath    String                   @map("local_path") @db.VarChar(500)
  checksum     String?                  @db.VarChar(128)
  uploadedAt   DateTime                 @default(now()) @map("uploaded_at")
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@map("payment_proof_documents")
}

// One execution of an inference pipeline (today: "brain" = classification,
// then segmentation for meningioma/pituitary) on a patient image. Separate
// from PatientAiAnalysis, which records manually entered analyses. The
// classification fields stay null while RUNNING and on a failure.
model AiAnalysisRun {
  id                          String              @id @default(cuid())
  patientId                   String              @map("patient_id")
  sourceDocumentId            String              @map("source_document_id")
  pipeline                    String              @db.VarChar(40)
  status                      AiAnalysisRunStatus
  classificationModelId       String?             @map("classification_model_id") @db.VarChar(120)
  classificationWeightsSha256 String?             @map("classification_weights_sha256") @db.Char(64)
  predictions                 Json?
  segmentationModelId         String?             @map("segmentation_model_id") @db.VarChar(120)
  segmentationWeightsSha256   String?             @map("segmentation_weights_sha256") @db.Char(64)
  maskPath                    String?             @map("mask_path") @db.VarChar(512)
  maskAreaPx                  Int?                @map("mask_area_px")
  maskAreaRatio               Float?              @map("mask_area_ratio")
  segmentationSkippedReason   String?             @map("segmentation_skipped_reason") @db.VarChar(60)
  // Pathology runs. Never in `predictions`, which holds the brain classifier's
  // probabilities only: the BreakHis score is not a probability.
  // Slide magnification (40, 100, 200 or 400); 40 for the nuclei segmentation.
  magnification               Int?
  // BreakHis: mean of the 4 test-time augmentation scores (not calibrated),
  // the threshold it was compared with, the 4 scores, and the result
  // (benign | malignant).
  malignancyScore             Float?              @map("malignancy_score")
  decisionThreshold           Float?              @map("decision_threshold")
  ttaScores                   Json?               @map("tta_scores")
  modelDecision               String?             @map("model_decision") @db.VarChar(20)
  // PanNuke: pixel shares (background; nucleus types among nucleus pixels),
  // tiles run, and the colour overlay (next to the label map in maskPath).
  nucleiFractions             Json?               @map("nuclei_fractions")
  tileCount                   Int?                @map("tile_count")
  overlayPath                 String?             @map("overlay_path") @db.VarChar(512)
  // Cardiology ECG: `predictions` holds the probabilities per class, the
  // thresholds, the classes above them, the windows and the input's rate and
  // duration; tracePath the first 10 s filtered (JSON, mV at 100 Hz), as drawn.
  tracePath                   String?             @map("trace_path") @db.VarChar(512)
  // Cardiac MRI segmentation: the slice as analysed (8-bit PNG), shown under
  // the overlay: a DICOM source cannot be shown as it is.
  slicePath                   String?             @map("slice_path") @db.VarChar(512)
  clinicianImpression         String?             @map("clinician_impression") @db.Text
  errorCode                   String?             @map("error_code") @db.VarChar(60)
  durationMs                  Int?                @map("duration_ms")
  requestedById               String              @map("requested_by_id")
  // The physician's decision: set once, never changed (a decision is final).
  decisionStatus              AiRunDecision?      @map("decision_status")
  // Label kept by the physician: the model's answer (VALIDATED: the brain top
  // class, the BreakHis result) or their correction (CORRECTED); null when
  // the analysis is REJECTED, and for a validated nuclei map (no label).
  decisionLabel               String?             @map("decision_label") @db.VarChar(40)
  // Cardiology ECG (multi-label): the classes kept, the model's positive
  // classes (VALIDATED) or the correction (CORRECTED); decisionLabel stays null.
  decisionLabels              Json?               @map("decision_labels")
  decisionReason              String?             @map("decision_reason") @db.Text
  decidedById                 String?             @map("decided_by_id")
  decidedAt                   DateTime?           @map("decided_at")
  createdAt                   DateTime            @default(now()) @map("created_at")
  updatedAt                   DateTime            @updatedAt @map("updated_at")

  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  sourceDocument PatientDocument   @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict)
  requestedBy    User              @relation("AiAnalysisRunRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy      User?             @relation("AiAnalysisRunDecidedBy", fields: [decidedById], references: [id], onDelete: Restrict)
  report         AiAnalysisReport?

  @@index([patientId])
  @@index([sourceDocumentId])
  @@index([requestedById])
  @@index([decidedById])
  @@map("ai_analysis_runs")
}

// The official PDF report of a decided run: generated once, then served as
// stored, never regenerated (a frozen medical document).
model AiAnalysisReport {
  id            String   @id @default(cuid())
  // One report per run: of two simultaneous first requests, only one row lands.
  runId         String   @unique @map("run_id")
  // CR-IA-<year>-<NNNNNN>, sequential within the year.
  reportNumber  String   @unique @map("report_number") @db.VarChar(20)
  filePath      String   @map("file_path") @db.VarChar(512)
  // SHA-256 of the stored PDF file.
  sha256        String   @db.Char(64)
  // SHA-256 of the report's content (the facts it prints), printed on the
  // document as its fingerprint: a file cannot contain its own hash.
  contentSha256 String   @map("content_sha256") @db.Char(64)
  sizeBytes     Int      @map("size_bytes")
  generatedById String   @map("generated_by_id")
  createdAt     DateTime @default(now()) @map("created_at")

  run            AiAnalysisRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  generatedBy    User            @relation("AiAnalysisReportGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)
  clinicalReport ClinicalReport?

  @@index([generatedById])
  @@map("ai_analysis_reports")
}

// --- Messaging (docs/messaging-design.md, section 4) -------------------------
// Message bodies are encrypted by the application (AES-256-GCM,
// src/messaging/message-crypto.ts): the database never holds their text.

model Conversation {
  id            String           @id @default(cuid())
  type          ConversationType
  // GROUP, CASE.
  title         String?          @db.VarChar(120)
  // GROUP, CASE.
  workspaceId   String?          @map("workspace_id")
  // CASE.
  patientId     String?          @map("patient_id")
  // DIRECT: the two user ids, sorted; one conversation per pair.
  directKey     String?          @unique @map("direct_key") @db.VarChar(64)
  createdById   String           @map("created_by_id")
  // Sequence number of the last message, incremented in the sending
  // transaction: messages are numbered 1, 2, 3... without gap.
  lastSeq       Int              @default(0) @map("last_seq")
  lastMessageAt DateTime?        @map("last_message_at")
  archivedAt    DateTime?        @map("archived_at")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  workspace     Workspace?                @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  patient       Patient?                  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  createdBy     User                      @relation("ConversationCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  participants  ConversationParticipant[]
  messages      Message[]
  attachments   MessageAttachment[]
  clinicalNotes PatientClinicalNote[]
  views         CaseConversationView[]
  readMarks     ConversationReadMark[]

  @@index([workspaceId, lastMessageAt])
  @@index([patientId])
  @@index([createdById])
  @@map("conversations")
}

model ConversationParticipant {
  id             String            @id @default(cuid())
  conversationId String            @map("conversation_id")
  userId         String            @map("user_id")
  // OWNER | MEMBER.
  role           String            @db.VarChar(20)
  status         ParticipantStatus @default(ACTIVE)
  // Unread messages: conversation.lastSeq - lastReadSeq.
  lastReadSeq    Int               @default(0) @map("last_read_seq")
  // When lastReadSeq last moved forward (a reading, or a message sent).
  lastReadAt     DateTime?         @map("last_read_at")
  mutedUntil     DateTime?         @map("muted_until")
  joinedAt       DateTime          @default(now()) @map("joined_at")
  leftAt         DateTime?         @map("left_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId, status])
  @@map("conversation_participants")
}

model Message {
  id              String          @id @default(cuid())
  conversationId  String          @map("conversation_id")
  seq             Int
  // null: a system message.
  senderId        String?         @map("sender_id")
  // Chosen by the client (a UUID): sending again does not duplicate.
  clientMessageId String?         @map("client_message_id") @db.VarChar(64)
  kind            MessageKind     @default(TEXT)
  // AES-256-GCM: iv (12 bytes) || tag (16 bytes) || ciphertext.
  bodyCiphertext  Bytes?          @map("body_ciphertext")
  keyId           String?         @map("key_id") @db.VarChar(16)
  priority        MessagePriority @default(NORMAL)
  requiresAck     Boolean         @default(false) @map("requires_ack")
  replyToId       String?         @map("reply_to_id")
  editedAt        DateTime?       @map("edited_at")
  // Logical deletion: shown as deleted, kept encrypted for the audit.
  deletedAt       DateTime?       @map("deleted_at")
  createdAt       DateTime        @default(now()) @map("created_at")

  conversation  Conversation          @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender        User?                 @relation("MessageSender", fields: [senderId], references: [id], onDelete: Restrict)
  replyTo       Message?              @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies       Message[]             @relation("MessageReplies")
  revisions     MessageRevision[]
  attachments   MessageAttachment[]
  acks          MessageAck[]
  clinicalNotes PatientClinicalNote[]

  @@unique([conversationId, seq])
  @@unique([senderId, clientMessageId])
  @@index([replyToId])
  @@map("messages")
}

// The previous versions of an edited message (medico-legal record), never
// shown by default.
model MessageRevision {
  id             String   @id @default(cuid())
  messageId      String   @map("message_id")
  bodyCiphertext Bytes    @map("body_ciphertext")
  keyId          String   @map("key_id") @db.VarChar(16)
  createdAt      DateTime @default(now()) @map("created_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("message_revisions")
}

model UserBlock {
  id        String   @id @default(cuid())
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

// A file sent in a conversation. Uploaded first (messageId null), then
// attached to the message that sends it; one never sent is deleted after
// 24 hours. Either an encrypted copy on disk (storagePath, keyId:
// AES-256-GCM, iv || tag || ciphertext, the attachment id authenticated with
// it), or, in a CASE conversation, a reference to a document of the patient
// record (patientDocumentId), never copied.
model MessageAttachment {
  id                String   @id @default(cuid())
  conversationId    String   @map("conversation_id")
  uploaderId        String   @map("uploader_id")
  messageId         String?  @map("message_id")
  // Under UPLOAD_ROOT/messaging/<conversationId>/; null for a reference.
  storagePath       String?  @map("storage_path") @db.VarChar(500)
  mimeType          String   @map("mime_type") @db.VarChar(100)
  sizeBytes         Int      @map("size_bytes")
  // Of the file in clear, checked again at each download.
  sha256            String   @db.Char(64)
  originalName      String   @map("original_name") @db.VarChar(255)
  // The MESSAGING_KEYS key that encrypted it; null for a reference.
  keyId             String?  @map("key_id") @db.VarChar(16)
  patientDocumentId String?  @map("patient_document_id")
  createdAt         DateTime @default(now()) @map("created_at")

  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  uploader        User             @relation(fields: [uploaderId], references: [id], onDelete: Restrict)
  message         Message?         @relation(fields: [messageId], references: [id], onDelete: SetNull)
  patientDocument PatientDocument? @relation(fields: [patientDocumentId], references: [id], onDelete: SetNull)

  @@index([conversationId])
  @@index([messageId, createdAt])
  @@index([uploaderId])
  @@index([patientDocumentId])
  @@map("message_attachments")
}

// The acknowledgement of an urgent message that requires one, by one of its
// recipients.
model MessageAck {
  id        String   @id @default(cuid())
  messageId String   @map("message_id")
  userId    String   @map("user_id")
  ackedAt   DateTime @default(now()) @map("acked_at")

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
  @@map("message_acks")
}

// A note of the patient record. From the messaging: a message of a CASE
// discussion "filed to the record", its text copied with its author and its
// date (the record keeps it whatever becomes of the conversation); a given
// message is filed once.
model PatientClinicalNote {
  id                   String             @id @default(cuid())
  patientId            String             @map("patient_id")
  // Who filed it.
  authorId             String             @map("author_id")
  source               ClinicalNoteSource
  sourceConversationId String?            @map("source_conversation_id")
  sourceMessageId      String?            @map("source_message_id")
  originalAuthorName   String             @map("original_author_name") @db.VarChar(120)
  originalSentAt       DateTime           @map("original_sent_at")
  content              String             @db.Text
  comment              String?            @db.VarChar(1000)
  createdAt            DateTime           @default(now()) @map("created_at")

  patient            Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  author             User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  sourceConversation Conversation? @relation(fields: [sourceConversationId], references: [id], onDelete: SetNull)
  sourceMessage      Message?      @relation(fields: [sourceMessageId], references: [id], onDelete: SetNull)

  @@unique([patientId, sourceMessageId])
  @@index([patientId, createdAt])
  @@index([authorId])
  @@index([sourceConversationId])
  @@index([sourceMessageId])
  @@map("patient_clinical_notes")
}

// Each time a participant's read position moves forward, never one row per
// message: a message was seen at the readAt of the first mark of that
// participant whose seq reaches it.
model ConversationReadMark {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  seq            Int
  readAt         DateTime @default(now()) @map("read_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, userId, seq])
  @@index([userId])
  @@map("conversation_read_marks")
}

// The days a user read a CASE discussion: MESSAGES_VIEWED goes to the
// patient's audit once a day per user and conversation, the unique key
// deciding which call writes it.
model CaseConversationView {
  id             String   @id @default(cuid())
  conversationId String   @map("conversation_id")
  userId         String   @map("user_id")
  // The day in Africa/Algiers.
  day            DateTime @db.Date
  createdAt      DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId, day])
  @@index([userId])
  @@map("case_conversation_views")
}

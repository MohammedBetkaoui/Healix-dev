  printCount                Int                @default(0) @map("print_count")
  regulatoryData            Json?              @map("regulatory_data")
  patientSnapshot           Json?              @map("patient_snapshot")
  prescriberSnapshot        Json?              @map("prescriber_snapshot")
  organizationSnapshot      Json?              @map("organization_snapshot")
  insuranceSnapshot         Json?              @map("insurance_snapshot")
  clinicalContextSnapshot   Json?              @map("clinical_context_snapshot")
  safetySnapshot            Json?              @map("safety_snapshot")
  regulatorySnapshot        Json?              @map("regulatory_snapshot")
  contentFingerprint        String?            @map("content_fingerprint") @db.Char(64)
  createdAt                 DateTime           @default(now()) @map("created_at")
  updatedAt                 DateTime           @updatedAt @map("updated_at")

  workspace           Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  patient             Patient               @relation(fields: [patientId], references: [id], onDelete: Restrict)
  prescriber          DoctorProfile         @relation(fields: [prescriberDoctorProfileId], references: [id], onDelete: Restrict)
  encounter           PatientConsultation?  @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  createdBy           User                  @relation("PrescriptionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  validatedBy         User?                 @relation("PrescriptionValidatedBy", fields: [validatedById], references: [id], onDelete: Restrict)
  canceledBy          User?                 @relation("PrescriptionCanceledBy", fields: [canceledById], references: [id], onDelete: Restrict)
  basedOnPrescription Prescription?         @relation("PrescriptionRenewals", fields: [basedOnPrescriptionId], references: [id], onDelete: Restrict)

model ClinicalReport {
  id                   String                 @id @default(cuid())
  // CR-<year>-<NNNNNN> (CLINICAL_REPORT sequence), given when the version is
  // finalized; CR-IA-<year>-<NNNNNN> for the report of an AI analysis.
  number               String?                @unique @db.VarChar(20)
  workspaceId          String                 @map("workspace_id")
  patientId            String                 @map("patient_id")
  encounterId          String?                @map("encounter_id")
  category             ClinicalReportCategory
  sourceType           ClinicalReportSource   @map("source_type")
  status               ClinicalReportStatus   @default(DRAFT)
  title                String                 @db.VarChar(200)
  conclusion           String?                @db.Text
  // [{ id, title, body }]
  sections             Json
  // Date of the clinical act the report is about.
  effectiveAt          DateTime               @default(now()) @map("effective_at")
  version              Int                    @default(1)
  // The version this one replaces; one successor at most.
  replacesId           String?                @unique @map("replaces_id")
  supersededAt         DateTime?              @map("superseded_at")
  authorId             String                 @map("author_id")
  finalizedAt          DateTime?              @map("finalized_at")
  finalizedById        String?                @map("finalized_by_id")
  canceledAt           DateTime?              @map("canceled_at")
  canceledById         String?                @map("canceled_by_id")
  cancellationReason   String?                @map("cancellation_reason") @db.Text
  // Frozen when the version is finalized (immutable afterwards).
  patientSnapshot      Json?                  @map("patient_snapshot")
  authorSnapshot       Json?                  @map("author_snapshot")
  organizationSnapshot Json?                  @map("organization_snapshot")
  contentFingerprint   String?                @map("content_fingerprint") @db.Char(64)
  // Imported document: who wrote it outside (author, specialty).
  externalSource       Json?                  @map("external_source")
  aiAnalysisReportId   String?                @unique @map("ai_analysis_report_id")
  patientDocumentId    String?                @unique @map("patient_document_id")
  createdAt            DateTime               @default(now()) @map("created_at")
  updatedAt            DateTime               @updatedAt @map("updated_at")

  workspace        Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  patient          Patient                 @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter        PatientConsultation?    @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  replaces         ClinicalReport?         @relation("ClinicalReportVersions", fields: [replacesId], references: [id], onDelete: Restrict)
  replacedBy       ClinicalReport?         @relation("ClinicalReportVersions")
  author           User                    @relation("ClinicalReportAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  finalizedBy      User?                   @relation("ClinicalReportFinalizedBy", fields: [finalizedById], references: [id], onDelete: Restrict)
  canceledBy       User?                   @relation("ClinicalReportCanceledBy", fields: [canceledById], references: [id], onDelete: Restrict)
  aiAnalysisReport AiAnalysisReport?       @relation(fields: [aiAnalysisReportId], references: [id], onDelete: Cascade)
  patientDocument  PatientDocument?        @relation(fields: [patientDocumentId], references: [id], onDelete: Restrict)
  document         ClinicalReportDocument?

  @@index([workspaceId, supersededAt])
  @@index([patientId])
  @@index([status])
  @@index([category])
  @@index([effectiveAt])
  @@index([authorId])
  @@index([encounterId])
  @@map("clinical_reports")
}

// The PDF generated when a written report is finalized (the report of an AI
// analysis keeps the PDF of ai_analysis_reports; an imported one, its file).
model ClinicalReportDocument {
  id                 String   @id @default(cuid())
  reportId           String   @unique @map("report_id")
  storedName         String   @map("stored_name") @db.VarChar(255)

  mimeType           String   @default("application/pdf") @map("mime_type") @db.VarChar(100)
  size               Int
  checksum           String   @db.Char(64)
  contentFingerprint String   @map("content_fingerprint") @db.Char(64)
  generatedById      String   @map("generated_by_id")
  generatedAt        DateTime @default(now()) @map("generated_at")

  report      ClinicalReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  generatedBy User           @relation("ClinicalReportDocumentGeneratedBy", fields: [generatedById], references: [id], onDelete: Restrict)

  @@index([generatedById])
  @@map("clinical_report_documents")
}

model ClinicalDocumentSequence {

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HealixDz Desktop",
  "version": "0.1.0",
  "identifier": "dz.healix.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "HealixDz Desktop",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "HealixDz",
    "copyright": "© 2026 HealixDz. Tous droits réservés.",
    "category": "Medical",
    "shortDescription": "Continuité clinique HealixDz hors connexion",
    "longDescription": "HealixDz Desktop donne au médecin un accès clinique sécurisé hors connexion : consultations, ordonnances en brouillon et cache patients, chiffrés localement (SQLCipher) et synchronisés avec le backend HealixDz dès le retour du réseau.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "digestAlgorithm": "sha256",
      "timestampUrl": "http://timestamp.digicert.com",
      "allowDowngrades": false,
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      },
      "wix": {
        "upgradeCode": "1ae3c273-b1bc-481d-a778-b77c273a9a55"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYwODU2OTJGQTY2RkM2QjQKUldTMHhtK21MMm1GOEl2RnUzZUZMYlo0a1dkYkhLd3dJbzk4UDBDZ21qd3Vyc01Wc0paaFErQW0K",
      "endpoints": [
        "https://github.com/MohammedBetkaoui/Healix-dev/releases/latest/download/latest.json"
      ]
    }
  }
}

# Model weights are never committed (about 1 GB); see README for AI_MODELS_DIR.
*.pth
.venv/
__pycache__/
.pytest_cache/
# Datasets (Nickparvar, BRISC...) are never committed, wherever they are unpacked.
data/
datasets/
# Evaluation: only the JSON reports (no image, no patient data).
evaluation/*
!evaluation/*.json

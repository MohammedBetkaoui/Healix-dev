# Model weights (about 1 GB) are never committed; the AI service reads them
# from AI_MODELS_DIR (see ai-service/README.md).
/models/
*.pth
*.keras

# Docker deployment settings and secrets (template: .env.docker.example).
/.env

# Backups of the Docker deployment (patient data): never committed.
/backups/

# Logs of local runs (ai-service/.runlogs, next dev...): never committed.
.runlogs/
*.log

# pytest-full-cardio

# Site configuration shared by Caddyfile (production) and Caddyfile.dev,
# imported inside their site block.

# Compressed responses (already compressed ones, such as PDF or PNG, are
# left alone).
encode zstd gzip

# Largest accepted upload: 20 MiB per file (patient documents, images sent to
# the AI service), plus the multipart envelope. The backend checks each file
# again. One exception: the import of a DICOM study (several .dcm files or one
# ZIP), up to 512 MiB, on that route only. request_body comes before the
# handle blocks in Caddy's directive order, so the two limits are chosen here,
# each request getting exactly one of them.
@dicom_upload path /api/dicom/studies/upload
@not_dicom_upload {
	not path /api/dicom/studies/upload
}
request_body @dicom_upload {
	max_size 512MiB
}
request_body @not_dicom_upload {
	max_size 21MiB
}

# Security headers, on every response, set here only. The pages' own
# Content-Security-Policy comes from Next.js (a nonce per request, in
# frontend/src/proxy.ts); the API's is below.
header {
	Strict-Transport-Security "max-age=31536000; includeSubDomains"
	X-Content-Type-Options "nosniff"
	Referrer-Policy "strict-origin-when-cross-origin"
	Permissions-Policy "camera=(), microphone=(), geolocation=()"
	-Server
	-X-Powered-By
}

# Optional: back office reachable from a list of addresses only (offices,
# VPN). ADMIN_ALLOWED_IPS, space-separated addresses or CIDR ranges; the
# default lets everyone through, i.e. the restriction is off. Covers the
# back-office pages (ADMIN_GATE_PATH) and its API (/api/admin). First of the
# handle blocks below: they are tried in this order, the last one catches
# the rest.
@admin_outside_allowlist {
	path {$ADMIN_GATE_PATH:/hzdz-control-gate-2026} {$ADMIN_GATE_PATH:/hzdz-control-gate-2026}/* /api/admin /api/admin/*
	not remote_ip {$ADMIN_ALLOWED_IPS:0.0.0.0/0 ::/0}
}
handle @admin_outside_allowlist {
	respond 403
}

# The DICOM viewer (OHIF), built to live under /viewer/. Static files: the
# page holds no data, the images come from /api/dicomweb, which the backend
# opens to a signed-in user for the studies of their workspace only. Its
# Content-Security-Policy is its own (the pages' one is Next.js's):
#  - script-src 'self' 'wasm-unsafe-eval': only our scripts (OHIF's inline
#    scripts were moved to files at build time), and WebAssembly for the image
#    decoders (not 'unsafe-eval');
#  - worker-src 'self' blob: : OHIF's decoding workers;
#  - img-src 'self' data: blob: : the images are drawn from blob: URLs;
#  - style-src 'self' 'unsafe-inline' : OHIF sets styles from its code;
#  - connect-src 'self' : the images and the API, on this origin and no other;
#  - frame-ancestors 'self' : only a HealixDz page may frame it.
@viewer path /viewer /viewer/*
handle @viewer {
	header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self' blob:; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; font-src 'self' data:; frame-ancestors 'self'"

	reverse_proxy {$VIEWER_UPSTREAM:viewer:8080}
}

# The API, path unchanged (Nest's global prefix is /api). One exception: the
# frontend's own route that clears the session cookies when the backend
# cannot be reached (src/app/api/auth/local-logout).
@api {
	path /api /api/*
	not path /api/auth/local-logout
}
handle @api {
	# JSON and files, never pages: nothing may run or be framed.
	header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"

	reverse_proxy {$BACKEND_UPSTREAM:backend:3001} {
		# The backend's audit log reads these before X-Forwarded-For: only
		# Caddy may tell it the client's address. X-Forwarded-For itself is
		# set by Caddy (a client's own value is ignored).
		header_up -Cf-Connecting-Ip
		header_up -True-Client-Ip
		header_up X-Real-Ip {remote_host}
	}
}

# Everything else: the Next.js server.
handle {
	reverse_proxy {$FRONTEND_UPSTREAM:frontend:3000} {
		header_up -Cf-Connecting-Ip
		header_up -True-Client-Ip
		header_up X-Real-Ip {remote_host}
	}
}
